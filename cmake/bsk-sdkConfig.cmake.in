@PACKAGE_INIT@

get_filename_component(_bsk_sdk_config_dir "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_bsk_sdk_cmake_dir  "${_bsk_sdk_config_dir}" PATH)   # .../cmake
get_filename_component(_bsk_sdk_lib_dir    "${_bsk_sdk_cmake_dir}" PATH)    # .../lib
get_filename_component(_bsk_sdk_pkg_dir    "${_bsk_sdk_lib_dir}" PATH)      # <pkg root>

set(BSK_SDK_PKG_DIR            "${_bsk_sdk_pkg_dir}"                CACHE PATH "bsk-sdk package root")
set(BSK_SDK_INCLUDE_DIR        "${BSK_SDK_PKG_DIR}/include"         CACHE PATH "bsk-sdk include root")
set(BSK_SDK_C_MSG_INTERFACE_DIR "${BSK_SDK_INCLUDE_DIR}/cMsgCInterface" CACHE PATH "bsk-sdk built-in C message interface dir")
set(BSK_SDK_COMPAT_INCLUDE_DIR "${BSK_SDK_INCLUDE_DIR}/compat"      CACHE PATH "bsk-sdk compat include dir")
set(BSK_SDK_ARCH_MIN_DIR       "${BSK_SDK_PKG_DIR}/arch_min"        CACHE PATH "bsk-sdk arch_min sources dir")
set(BSK_SDK_ARCH_UTILITIES_DIR "${BSK_SDK_PKG_DIR}/arch_utilities"  CACHE PATH "bsk-sdk arch_utilities sources dir")
set(BSK_SDK_RUNTIME_MIN_DIR    "${BSK_SDK_PKG_DIR}/runtime_min"     CACHE PATH "bsk-sdk runtime_min sources dir")
set(BSK_SDK_SWIG_DIR           "${BSK_SDK_PKG_DIR}/swig"            CACHE PATH "bsk-sdk swig dir")
set(BSK_SDK_TOOLS_DIR          "${BSK_SDK_PKG_DIR}/tools"           CACHE PATH "bsk-sdk tools dir")
set(BSK_SDK_RUST_DIR           "${BSK_SDK_PKG_DIR}/rust"            CACHE PATH "bsk-sdk Rust support dir")
set(BSK_SDK_RUST_CMAKE_DIR     "${BSK_SDK_RUST_DIR}/cmake"          CACHE PATH "bsk-sdk synchronized Rust CMake dir")
set(BSK_SDK_C_MSG_TEMPLATE_DIR "${BSK_SDK_PKG_DIR}/message_templates" CACHE PATH "bsk-sdk C-message templates")

# Provide Eigen3::Eigen from bundled headers so extensions are self-contained.
if(NOT TARGET Eigen3::Eigen)
  add_library(Eigen3::Eigen IMPORTED INTERFACE GLOBAL)
  set_target_properties(Eigen3::Eigen PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${BSK_SDK_INCLUDE_DIR}/eigen3"
  )
endif()

# Header-only SDK target used by the shared vendored runtime and its consumers.
if(NOT TARGET bsk::sdk_headers)
  add_library(bsk::sdk_headers IMPORTED INTERFACE GLOBAL)
  set_target_properties(bsk::sdk_headers PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES
      "${BSK_SDK_INCLUDE_DIR};${BSK_SDK_C_MSG_INTERFACE_DIR};${BSK_SDK_COMPAT_INCLUDE_DIR};${BSK_SDK_INCLUDE_DIR}/Basilisk"
    INTERFACE_COMPILE_FEATURES "cxx_std_17"
  )
endif()

# Read the BSK version this SDK was synced from.
file(STRINGS "${_bsk_sdk_pkg_dir}/_bsk_version.txt" BSK_SDK_BSK_VERSION LIMIT_COUNT 1)
include("${_bsk_sdk_config_dir}/bsk_extension_compatibility.cmake")

# Validate the installed Basilisk version matches the SDK at configure time.
function(_bsk_sdk_check_basilisk_version)
  find_package(Python3 QUIET COMPONENTS Interpreter)
  if(NOT Python3_FOUND)
    return()
  endif()

  execute_process(
    COMMAND "${Python3_EXECUTABLE}" -c
      "try:\n    import Basilisk; print(Basilisk.__version__, end='')\nexcept Exception:\n    print('', end='')"
    OUTPUT_VARIABLE _bsk_installed_version
    RESULT_VARIABLE _rc
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )

  if(NOT _rc EQUAL 0 OR _bsk_installed_version STREQUAL "")
    return()
  endif()

  # Use STREQUAL rather than VERSION_EQUAL as CMake version comparisons truncate
  # non-numeric suffixes, so "2.11.0beta" would compare equal to "2.11.0" and
  # silently skip the mismatch path.
  if(NOT _bsk_installed_version STREQUAL BSK_SDK_BSK_VERSION)
    _bsk_sdk_require_exact_basilisk_version(
      "${_bsk_installed_version}" "${BSK_SDK_BSK_VERSION}")
  endif()
endfunction()

_bsk_sdk_check_basilisk_version()

include("${_bsk_sdk_config_dir}/bsk_add_swig_module.cmake")
include("${_bsk_sdk_config_dir}/bsk_add_python_module.cmake")
include("${_bsk_sdk_config_dir}/bsk_generate_messages.cmake")
include("${_bsk_sdk_config_dir}/bsk_add_rust_module.cmake")

check_required_components(bsk-sdk)
