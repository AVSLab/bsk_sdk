"""Runtime compatibility information generated by bsk-sdk."""

import re


EXPECTED_BSK_VERSION = "@BSK_EXTENSION_COMPATIBILITY_VERSION@"
EXPECTED_EXTENSION_ABI = @BSK_EXTENSION_ABI_VERSION@
EXTENSION_NAME = "@BSK_EXTENSION_COMPATIBILITY_NAME@"


def _matching_basilisk_guidance() -> str:
    """Return installation guidance appropriate for the expected release."""
    version = EXPECTED_BSK_VERSION.lower()
    if re.search(r"(?:a|b|alpha|beta)[0-9]+$", version):
        return (
            "Alpha and beta extensions require matching Basilisk and bsk-sdk "
            "sources or wheels. Install or build the intended Basilisk prerelease, "
            "or rebuild the extension with bsk-sdk synchronized from that same "
            "Basilisk checkout."
        )
    if re.search(r"rc[0-9]+$", version):
        return (
            "Install the matching Basilisk release candidate with "
            "`python -m pip install --pre --index-url "
            "https://test.pypi.org/simple/ --extra-index-url "
            f"https://pypi.org/simple/ \"bsk=={EXPECTED_BSK_VERSION}\"`."
        )
    return (
        "Install the matching Basilisk release with "
        f"`python -m pip install \"bsk=={EXPECTED_BSK_VERSION}\"`."
    )


def check_basilisk_compatibility() -> None:
    """Reject an incompatible Basilisk runtime before loading native modules."""
    try:
        import Basilisk
    except ImportError as error:
        raise ImportError(
            f"{EXTENSION_NAME} requires Basilisk {EXPECTED_BSK_VERSION}, but "
            f"Basilisk could not be imported. {_matching_basilisk_guidance()}"
        ) from error

    installed_version = getattr(Basilisk, "__version__", None)
    if installed_version != EXPECTED_BSK_VERSION:
        raise ImportError(
            f"{EXTENSION_NAME} was built for Basilisk {EXPECTED_BSK_VERSION}, but "
            f"Basilisk {installed_version or 'an unknown version'} is installed. "
            f"{_matching_basilisk_guidance()}"
        )

    try:
        build_info = Basilisk.getBuildInfo()
        installed_abi = build_info["artifact"]["extensionAbiVersion"]
    except (AttributeError, KeyError, RuntimeError, TypeError) as error:
        raise ImportError(
            f"{EXTENSION_NAME} could not read the Basilisk extension ABI. "
            f"{_matching_basilisk_guidance()}"
        ) from error

    if installed_abi != EXPECTED_EXTENSION_ABI:
        raise ImportError(
            f"{EXTENSION_NAME} was built for Basilisk extension ABI "
            f"{EXPECTED_EXTENSION_ABI}, but the installed Basilisk provides ABI "
            f"{installed_abi}. {_matching_basilisk_guidance()}"
        )
